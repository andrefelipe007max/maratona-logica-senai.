programa {
  funcao inicio() {
    inteiro id, ida, ids

escreva("coloque o id da peça :\n")
  leia(id)
  ida = id - 1
  ids = id + 1
escreva("\nPara organizar a prateleira:")
    escreva("\nID da peça anterior: ", ida)
    escreva("\nID da peça atual: ", id)
    escreva("\nID da peça posterior: ", ids)
    
    
    
  }
}
//10. ID de Rastreabilidade: Cada peça tem um ID numérico. Para organizar a
//prateleira, peça o ID de uma peça e exiba o ID da peça que deve vir
//imediatamente antes e a que vem depois.