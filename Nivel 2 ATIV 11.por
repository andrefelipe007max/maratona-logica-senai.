programa {
  funcao inicio() {
    inteiro temperatura
    escreva(" Qual a temperatura do lugar: ")
    leia(temperatura)
    se ( temperatura > 100 )
    escreva("ALERTA: RISCO DE EXPLOSÃO, TEMPERATURA ATUAL DE: ", temperatura,"°C")
senao
escreva("Temperatura Estável")

    
    
    
  }
}
//11. Segurança de Caldeira: Um sensor monitora uma caldeira. Se a
//temperatura lida for maior que 100°C, exiba: "ALERTA: RISCO DE
///EXPLOSÃO". Caso contrário: "Temperatura Estável".