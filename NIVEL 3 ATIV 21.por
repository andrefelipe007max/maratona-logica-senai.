programa 
{
	funcao inicio() 
	{
		escreva("=== CHECKLIST DE SENSORES - FÁBRICA ===\n")
	  para (inteiro i = 1; i <= 50; i++) 
		{
		escreva("Sensor Nº de Série: SN-", i, "\n")
		}
    escreva("Relatório gerado com sucesso.")
	}
}
//21.Checklist de Sensores: Use um laço para exibir os números de série dos 50
//sensores espalhados pela fábrica (de 1 a 50).