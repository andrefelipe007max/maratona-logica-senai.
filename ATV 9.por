programa {
  funcao inicio() {
    real km, litro
  
    escreva("quantos km voce vai correr: kilometros(km): ")
    leia(km)
    litro = km * 12
    escreva("você precisa de ", litro," litros para pecorrer os" ,km," kilometros")

    
  }
}
//Autonomia de Entrega: O caminhão da fábrica gasta 1 litro de diesel a cada
//12km. Peça a distância da entrega e exiba quantos litros serão necessários
//para o trajeto.