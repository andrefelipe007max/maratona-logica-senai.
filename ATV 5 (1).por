programa {
  funcao inicio() {
    real a, b, c, x
escreva("connsumo de energia(kWh)  da primeira maquina:")
leia(a)
escreva("connsumo de energia(kWh)  da segunda maquina:")
leia(b)    
escreva("connsumo de energia(kWh) da terceira maquina:")
leia(c)

x = (a + b + c)/3

escreva(" A media de kWh por hora e:", x, "")
  }
}
