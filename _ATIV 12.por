programa {
  funcao inicio() {
    inteiro idade 
    escreva("Verifique sua idade: ")
    leia(idade)
    se ( idade >= 18) 
    escreva("Autorizado")
    senao
    escreva("Não Autorizado")
    
    
    
    
  }
}
