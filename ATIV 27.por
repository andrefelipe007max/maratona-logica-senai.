programa {
  funcao inicio() {
    inteiro media, temperatura = 0
   escreva("\nLeia a temperatura de 10 pontos diferentes da fábrica: ")
   
   para (inteiro i = 1; i <= 10; i++){
    escreva("A temperatura desse local e: ")
    leia(temperatura)
    media = (temperatura + temperatura)/2}
    
    escreva("A media e de: ", media)
  
    
  }
}
